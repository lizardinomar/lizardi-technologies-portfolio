---
import Triangle from './Triangle.astro';
import { fmtDate, fmtTime, cover, img, type AuctionX } from '@/lib/auctions';
interface Props { a: AuctionX; featured?: boolean }
const { a, featured = false } = Astro.props;
const label = { upcoming: 'Upcoming', live: 'Bidding open', past: 'Closed' }[a.status];
---
<a href={`/auctions/${a.slug}`} class:list={['group relative isolate block overflow-hidden rounded-3xl border border-white/10 bg-forest text-white transition duration-500 hover:-translate-y-1 hover:border-brass/50', featured && 'lg:grid lg:grid-cols-5']}>
  <div class:list={['relative overflow-hidden bg-gradient-to-br from-brand-deep via-forest-2 to-night', featured ? 'aspect-[16/10] lg:col-span-3 lg:aspect-auto lg:min-h-[420px]' : 'aspect-[16/10]']}>
    {cover(a)
      ? <img src={img(cover(a)!, 1200)} alt="" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" />
      : <Triangle class="absolute inset-x-0 bottom-0 w-full opacity-90 transition duration-700 group-hover:scale-110" draw={false} id={`c-${a.id.slice(-6)}`} />}
    <div class="absolute inset-0 bg-[radial-gradient(60%_60%_at_70%_20%,rgb(201_166_75/.35),transparent)]"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-night/70 via-transparent to-transparent"></div>
    <span class:list={['absolute left-5 top-5 inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 font-mono text-[10px] uppercase tracking-[.18em]', a.status === 'live' ? 'bg-brand text-white' : a.status === 'upcoming' ? 'bg-brass text-night' : 'bg-white/15 text-white/80 backdrop-blur']}>
      {a.status === 'live' && <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full rounded-full bg-white" style="animation:pulse-ring 1.6s infinite"></span><span class="relative h-2 w-2 rounded-full bg-white"></span></span>}
      {label}
    </span>
  </div>
  <div class:list={['relative p-7 md:p-9', featured && 'flex flex-col justify-end lg:col-span-2']}>
    <p class="font-mono text-xs uppercase tracking-[.18em] text-brass">{fmtDate(a.dateObj, { month: 'short', day: 'numeric', year: 'numeric' })} · {fmtTime(a.dateObj)}</p>
    <h3 class:list={['mt-3', featured ? 'text-5xl md:text-6xl' : 'text-4xl']}>{a.title}</h3>
    {a.venue && <p class="mt-3 text-sm text-white/60">{[a.venue, a.city].filter(Boolean).join(' · ')}</p>}
    {featured && (a.descriptionEn || a.description) && <p class="mt-5 line-clamp-4 text-base leading-relaxed text-white/70">{a.descriptionEn || a.description}</p>}
    <div class="mt-7 flex items-center gap-4 text-xs font-semibold uppercase tracking-[.14em] text-white">
      {a.lotCount ? <span class="text-white/60">{a.lotCount} lots</span> : null}
      <span class="ml-auto inline-flex items-center gap-2 transition group-hover:gap-4 group-hover:text-brass">View auction
        <svg width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true"><path d="M0 6h12m0 0L8 2m4 4L8 10" stroke="currentColor" stroke-width="1.5"/></svg>
      </span>
    </div>
  </div>
</a>
