---
interface Props { items: readonly string[]; reverse?: boolean; dur?: number; big?: boolean }
const { items, reverse = false, dur = 100, big = false } = Astro.props;
const list = [...items, ...items];
---
<div class="ticker-wrap overflow-hidden" aria-hidden="true">
  <div class:list={['ticker', reverse && 'rev']} style={`--dur:${dur}s`}>
    {list.map((t, i) => (
      <span class:list={['inline-flex shrink-0 items-center gap-8 pr-8 font-display whitespace-nowrap', big ? 'text-5xl md:text-7xl' : 'text-2xl md:text-4xl']}>
        <span class={i % 3 === 0 ? 'text-brass-soft' : i % 3 === 1 ? 'text-white' : 'text-brand-bright'}>{t}</span>
        <span class="text-brass">✦</span>
      </span>
    ))}
  </div>
</div>
