---
import { nav, site } from '@/lib/site';
const path = Astro.url.pathname;
const on = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
---
<header data-header class="group fixed inset-x-0 top-0 z-50 transition-all duration-500 [&.is-scrolled]:bg-night/80 [&.is-scrolled]:backdrop-blur-xl [&.is-scrolled]:shadow-[0_1px_0_rgb(255_255_255/.08)]">
  <div class="wrap flex items-center justify-between py-3 group-[.is-scrolled]:py-2 transition-all duration-500">
    <a href="/" aria-label={`${site.name} — home`} class="block">
      <img src="/logo-light.svg" width="137" height="48" alt={site.name} class="h-11 w-auto md:h-12" />
    </a>

    <nav class="hidden items-center gap-9 lg:flex" aria-label="Primary">
      {nav.map((n) => (
        <a href={n.href} aria-current={on(n.href) ? 'page' : undefined}
           class={`link-u text-[13px] font-medium tracking-wide ${on(n.href) ? 'text-brass' : 'text-white/85 hover:text-white'}`}>{n.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href="/auctions" data-magnetic class="btn btn-brass hidden !py-3 md:inline-flex">
        Live Auctions
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6h8m0 0L6.5 2.5M10 6l-3.5 3.5" stroke="currentColor" stroke-width="1.6"/></svg>
      </a>
      <button id="menu-toggle" class="flex h-11 w-11 items-center justify-center rounded-full glass lg:hidden" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true"><path d="M0 1h18M0 11h18" stroke="currentColor" stroke-width="1.5"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden fixed inset-0 -z-10 overflow-y-auto bg-night/98 px-6 pb-10 pt-28 lg:hidden">
    <nav class="flex flex-col gap-2" aria-label="Mobile">
      {nav.map((n) => (<a href={n.href} class="font-display text-5xl py-2 hover:text-brass transition">{n.label}</a>))}
    </nav>
    <div class="mt-10 flex flex-col gap-3 font-mono text-xs uppercase tracking-[.18em] text-white/60">
      <a href={`tel:${site.contact.phonePR}`}>PR {site.contact.phonePR}</a>
      <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
    </div>
  </div>
</header>
