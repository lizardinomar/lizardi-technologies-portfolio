---
// The logo's triangle, used as a recurring brand motif.
interface Props { class?: string; draw?: boolean; id?: string }
const { class: cls = '', draw = true, id = 't' } = Astro.props;
---
<svg viewBox="0 0 1000 360" fill="none" aria-hidden="true" class={cls} preserveAspectRatio="xMidYMid meet">
  <defs>
    <linearGradient id={`${id}-fill`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#369A6C" stop-opacity=".9" />
      <stop offset="1" stop-color="#369A6C" stop-opacity="0" />
    </linearGradient>
    <linearGradient id={`${id}-stroke`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#4CC28A" />
      <stop offset=".5" stop-color="#E3C97F" />
      <stop offset="1" stop-color="#C9A64B" />
    </linearGradient>
  </defs>
  <polygon points="500,8 992,352 8,352" fill={`url(#${id}-fill)`} opacity=".55" />
  <polyline points="8,352 500,8 992,352" stroke={`url(#${id}-stroke)`} stroke-width="2" stroke-linejoin="round" class={draw ? 'draw-path' : ''} />
</svg>
