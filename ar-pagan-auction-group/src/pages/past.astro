---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import AuctionCard from '@/components/AuctionCard.astro';
import Marquee from '@/components/Marquee.astro';
import { getAuctions } from '@/lib/auctions';
import { recentSales } from '@/data/auctions';

const archived = (await getAuctions()).filter((a) => a.status === 'past');
---
<BaseLayout title="Past Auctions" description="A partial record of the auctions and liquidations conducted by A.R. Pagán Auction Group since 1977.">
  <PageHero eyebrow="The record" title="Past" accent="auctions." />

  <section class="relative overflow-hidden border-y border-white/10 bg-gradient-to-r from-brand-deep via-forest-2 to-brand-deep py-10" aria-hidden="true">
    <Marquee items={recentSales} dur={120} big />
  </section>

  {archived.length > 0 && (
    <section class="on-light bg-paper py-20 text-ink md:py-28">
      <div class="wrap">
        <p class="eyebrow reveal mb-4">Recently closed</p>
        <h2 class="reveal mb-12 text-5xl md:text-7xl">Closed <span class="italic text-brand-deep">auctions</span></h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {archived.map((a) => (<div class="reveal"><AuctionCard a={a} /></div>))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-night py-20 md:py-28">
    <div class="wrap">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-8">
        <div>
          <p class="eyebrow reveal mb-4">Recent sales</p>
          <h2 class="reveal text-5xl md:text-7xl">Latest <span class="italic text-grad">liquidations</span></h2>
        </div>
      </div>
      <ul class="grid gap-3 md:grid-cols-2">
        {recentSales.map((n, i) => (
          <li class="reveal flex items-center gap-5 rounded-2xl border border-white/10 bg-forest px-6 py-5 transition hover:border-brass/50 hover:bg-forest-2">
            <span class="font-mono text-xs text-brass">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-display text-2xl md:text-3xl">{n}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

</BaseLayout>
