---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { site } from '@/lib/site';
const action = site.forms.formspree ? `https://formspree.io/f/${site.forms.formspree}` : '#';
const field = 'w-full rounded-2xl border border-white/15 bg-night/60 px-5 py-4 text-sm text-white placeholder:text-white/35 focus:border-brass focus:outline-none';
---
<BaseLayout title="Contact" description="Contact A.R. Pagán Auction Group about auctions, appraisals, liquidations or consigning assets.">
  <PageHero eyebrow="Contact" title="Let's talk" accent="assets." sub="Selling, appraising, consigning or bidding. Write or call and a person answers." />

  <section class="bg-forest py-20 md:py-28">
    <div class="wrap grid gap-14 lg:grid-cols-12">
      <form action={action} method="POST" data-ajax data-ok="Thank you. We'll be in touch shortly." class="reveal space-y-5 lg:col-span-7">
        <input type="hidden" name="_subject" value="New inquiry — arpagan.com" />
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <div class="grid gap-5 md:grid-cols-2">
          <div><label for="name" class="eyebrow mb-2 block">Name</label><input id="name" name="name" required autocomplete="name" class={field} /></div>
          <div><label for="email" class="eyebrow mb-2 block">Email</label><input id="email" type="email" name="email" required autocomplete="email" class={field} /></div>
          <div><label for="phone" class="eyebrow mb-2 block">Phone (optional)</label><input id="phone" type="tel" name="phone" autocomplete="tel" class={field} /></div>
          <div>
            <label for="topic" class="eyebrow mb-2 block">I'm interested in</label>
            <select id="topic" name="topic" class={field}>
              <option>General inquiry</option>
              <option>Consigning assets</option>
              <option>An appraisal</option>
              <option>A liquidation</option>
              <option>Bidding help</option>
            </select>
          </div>
        </div>
        <div><label for="message" class="eyebrow mb-2 block">Message</label><textarea id="message" name="message" rows="6" required class={field}></textarea></div>
        <div class="flex flex-wrap items-center gap-5">
          <button type="submit" data-magnetic class="btn btn-brass disabled:opacity-60">Send message</button>
          <p data-status role="status" aria-live="polite" class="text-sm"></p>
        </div>
      </form>

      <aside class="reveal space-y-6 lg:col-span-5">
        <div class="rounded-3xl border border-white/10 bg-night/60 p-8">
          <p class="eyebrow mb-5">Call</p>
          <a href={`tel:${site.contact.phonePR}`} class="block font-display text-5xl transition hover:text-brass">{site.contact.phonePR}</a>
          <p class="mt-1 text-sm text-white/50">Puerto Rico</p>
          <a href={`tel:${site.contact.phoneSF}`} class="mt-6 block font-display text-4xl text-white/80 transition hover:text-brass">{site.contact.phoneSF}</a>
          <p class="mt-1 text-sm text-white/50">San Francisco</p>
        </div>
        <div class="rounded-3xl border border-white/10 bg-night/60 p-8">
          <p class="eyebrow mb-4">Email</p>
          <a href={`mailto:${site.contact.email}`} class="link-u font-display text-3xl hover:text-brass">{site.contact.email}</a>
          <p class="eyebrow mb-3 mt-8">Hours</p>
          <p class="text-white/80">{site.contact.hoursDays}<br />{site.contact.hours}</p>
          <p class="eyebrow mb-3 mt-8">Mail</p>
          <p class="text-white/80">{site.contact.poBox}<br />{site.contact.poCity}</p>
          <p class="mt-4 text-white/80">{site.contact.sfPoBox}<br />{site.contact.sfPoCity}</p>
        </div>
        <div class="flex flex-wrap gap-4">
          <a href={site.contact.whatsapp} target="_blank" rel="noopener" class="btn btn-green">WhatsApp (787) 780-6464</a>
          <a href={site.forms.constantContact} target="_blank" rel="noopener" class="btn btn-brass">Join our mailing list</a>
          <a href={site.social.facebook} target="_blank" rel="noopener" class="btn btn-line">Facebook</a>
          <a href={site.social.instagram} target="_blank" rel="noopener" class="btn btn-line">Instagram</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
